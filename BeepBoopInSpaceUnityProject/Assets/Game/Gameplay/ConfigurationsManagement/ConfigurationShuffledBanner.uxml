<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="/Assets/Game/UITools/Screens/Screens.uss" />
    <ui:VisualElement name="configuration-shuffled-screen" class="ui-screen" picking-mode="Ignore">
        <ui:VisualElement class="banner-row banner-row--top" picking-mode="Ignore">
            <ui:VisualElement class="banner" picking-mode="Ignore">
                <ui:Label text="NOUVELLE CONFIGURATION DE TOUCHES !" class="ui-text ui-heading banner__label" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
