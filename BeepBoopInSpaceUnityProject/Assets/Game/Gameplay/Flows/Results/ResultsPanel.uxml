<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="/Assets/Game/UITools/Screens/Screens.uss" />
    <ui:VisualElement name="results-screen" class="ui-screen" picking-mode="Ignore">
        <ui:VisualElement class="results__continue-row" picking-mode="Ignore">
            <ui:Button name="back-to-menu-button" class="ui-button ui-button--with-glyph results__continue">
                <ui:VisualElement name="back-to-menu-glyph" class="ui-glyph" picking-mode="Ignore" />
                <ui:Label text="Retour au menu" class="ui-text ui-button__label" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
