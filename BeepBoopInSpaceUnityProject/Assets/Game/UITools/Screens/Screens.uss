/*
 * Styles of the UI Toolkit screens outside the main menu (game panels, pause, loading screen, tournament results):
 * a section per screen. None of them has a mockup of its own: they follow the style guide, whose components are
 * in Common.uss, imported first.
 */

@import url("/Assets/Game/UITools/Screens/Common.uss");

/* Announcements over the game: an insert that unrolls in a row across the screen (BannerScreen). */

.banner-row {
    position: absolute;
    left: 0;
    right: 0;
    align-items: center;
}

.banner-row--top {
    top: 120px;
}

.banner-row--middle {
    top: 470px;
}

.banner {
    height: 110px;
    padding: 0 70px;
    border-width: 3px;
    border-radius: 36px;
    border-color: var(--ui-outline);
    background-color: var(--ui-ink);
    justify-content: center;
}

/* BeepBoop is wide: the longest announcement ("Nouvelle configuration de touches !") must fit in 1920 px. */
.ui-screen .banner__label {
    font-size: 48px;
    -unity-text-align: middle-center;
    translate: 0 -2px;
}

/* Timer: a small cartouche hanging from the top of the screen. */

.timer-row {
    position: absolute;
    left: 0;
    right: 0;
    top: -3px;
    align-items: center;
}

.timer {
    width: 230px;
    height: 96px;
    border-width: 0 3px 3px 3px;
    border-color: var(--ui-outline);
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
    background-color: var(--ui-ink);
    justify-content: center;
}

.ui-screen .timer__label {
    font-size: 64px;
    -unity-text-align: middle-center;
    translate: 0 -4px;
}

/* Floating "+1" over a cell (WorldOverlayPanel): the anchor moves and fades, the label stays centered on it. */
.floating-text {
    position: absolute;
    width: 0;
    height: 0;
}

.ui-screen .floating-text__label {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 64px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ui-ink);
    translate: -50% -50%;
}

/* Tutorial: the game's rules on the left, the controls on the right, a card per player below. */

.tutorial__rules {
    position: absolute;
    left: 80px;
    top: 70px;
    width: 800px;
    padding: 40px 50px;
}

.ui-screen .tutorial__rules-title {
    font-size: 40px;
    margin-bottom: 4px;
}

.ui-screen .tutorial__rules-label {
    font-size: 48px;
    white-space: normal;
}

.ui-screen .tutorial__rules-title--spaced {
    margin-top: 40px;
}

.tutorial__modifier {
    flex-direction: row;
    align-items: center;
    margin-top: 40px;
}

.tutorial__modifier-icon {
    width: 90px;
    height: 90px;
    margin-right: 24px;
    background-image: url("/Assets/RawAssets/UI/Menus/Training/SPR_IconeMeteor.png");
    -unity-background-scale-mode: scale-to-fit;
}

.tutorial__controls {
    position: absolute;
    left: 950px;
    top: 50px;
    width: 900px;
    height: 506px;
    background-image: url("/Assets/RawAssets/Tutorial/UI_XboxController.png");
    -unity-background-scale-mode: scale-to-fit;
}

.tutorial__players {
    position: absolute;
    left: 0;
    right: 0;
    top: 610px;
    flex-direction: row;
    justify-content: center;
}

/* A player's card: white while waiting for the player, in the character's color once ready (set by the code). */
.tutorial-card {
    width: 300px;
    height: 360px;
    margin: 0 30px;
    padding: 0;
    border-width: 6px;
    border-radius: 48px;
    border-color: rgb(255, 255, 255);
    background-color: var(--ui-navy);
    align-items: center;
    transition-property: scale, border-color;
    transition-duration: 0.15s, 0.15s;
    transition-timing-function: ease-in-sine, ease-in-sine;
}

.tutorial-card--ready {
    scale: 1.06 1.06;
    transition-duration: 0.4s, 0.15s;
    transition-timing-function: ease-out-back, ease-out-sine;
}

.tutorial-card__icon {
    width: 200px;
    height: 250px;
    margin-top: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.tutorial-card__badge {
    position: absolute;
    left: 14px;
    top: 14px;
}

.tutorial-card__status {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 22px;
    height: 57px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.ui-screen .tutorial-card__status-label {
    font-size: 40px;
    translate: 0 -5px;
}

.tutorial-card__status-label--ready,
.tutorial-card--ready .tutorial-card__status-label--waiting,
.tutorial-card--ready .tutorial-card__glyph {
    display: none;
}

.tutorial-card--ready .tutorial-card__status-label--ready {
    display: flex;
    color: rgb(255, 255, 255);
}

.tutorial-card__glyph {
    margin-right: 10px;
}

/* Fills up while the game is about to start, everyone being ready. */
.tutorial__waiting-bar {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 16px;
    background-color: var(--ui-outline);
}

/* Results: the button to leave, under the podium. */

.results__continue-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 110px;
    align-items: center;
}

.results__continue {
    display: none;
}

.results__continue--shown {
    display: flex;
}

/* Pause: the game stays visible behind the shade; actions on the left, volumes on the right. */

.pause {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.pause--hidden {
    display: none;
}

.pause__actions {
    position: absolute;
    left: 150px;
    top: 330px;
    width: 520px;
    align-items: stretch;
}

.pause__action {
    margin-bottom: 40px;
}

.pause__action--main {
    height: 96px;
    padding-top: 12px;
    border-radius: 34px;
    font-size: 48px;
}

.pause__volumes {
    position: absolute;
    left: 790px;
    right: 110px;
    top: 290px;
}

/* Loading screen: the background, robots' alien friends walking by, and the word. */

.loading__walkers {
    position: absolute;
    left: 520px;
    top: 330px;
    width: 880px;
    height: 389px;
    background-image: url("/Assets/RawAssets/UI/Menus/LoadingScreen/SPR_WalkingAlien.png");
    -unity-background-scale-mode: scale-to-fit;
}

.loading__legend {
    right: 63px;
    top: 990px;
}

/* Wide enough for the dots that come and go, so the word doesn't move. */
.ui-screen .loading__label {
    width: 250px;
    font-size: 48px;
    -unity-text-align: middle-left;
    translate: 0 -5px;
}

/* Tournament results: a row per player, with a cell per game played, highlighted where the player won. */

.tournament__players {
    position: absolute;
    left: 140px;
    right: 140px;
    top: 175px;
}

.tournament-line {
    flex-direction: row;
    align-items: center;
    height: 170px;
    margin-bottom: 26px;
    padding: 0 30px 0 20px;
    overflow: hidden;
}

.tournament-line__icon {
    width: 120px;
    height: 150px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.tournament-line__badge {
    position: absolute;
    left: 14px;
    top: 12px;
    width: 46px;
    height: 46px;
    border-radius: 23px;
}

.ui-screen .tournament-line__badge .ui-badge__label {
    font-size: 26px;
}

.ui-screen .tournament-line__score {
    width: 130px;
    flex-shrink: 0;
    font-size: 96px;
    -unity-text-align: middle-center;
    translate: 0 -8px;
}

.tournament-line__games {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

/* A game: its level's thumbnail, faded when lost, outlined in the winner's color when won. */
.tournament-game {
    width: 180px;
    height: 112px;
    flex-shrink: 1;
    min-width: 60px;
    margin-right: 18px;
    border-width: 5px;
    border-radius: 20px;
    border-color: var(--ui-ink);
    background-color: var(--ui-ink);
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.35;
}

.tournament-game--won {
    opacity: 1;
}

.tournament__continue {
    position: absolute;
    right: 63px;
    top: 986px;
}
