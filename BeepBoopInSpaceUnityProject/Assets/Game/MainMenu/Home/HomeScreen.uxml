<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../UI/MainMenu.uss" />
    <ui:VisualElement name="home-screen" class="ui-screen" picking-mode="Ignore">
        <ui:VisualElement class="home-title" picking-mode="Ignore">
            <ui:Label text="BEEP BOOP" class="home-title__line home-title__main" picking-mode="Ignore" />
            <ui:Label text="DANS L&apos;ESPACE" class="home-title__line home-title__sub" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="ui-centered-row home-play-row" picking-mode="Ignore">
            <ui:Button name="play-button" text="Jouer" class="ui-button ui-button--big" />
        </ui:VisualElement>
        <ui:VisualElement class="ui-centered-row home-credits-row" picking-mode="Ignore">
            <ui:Button name="credits-button" text="Crédits" class="ui-button" />
        </ui:VisualElement>
        <ui:Button name="settings-button" text="Paramètres" class="ui-button ui-corner--bottom-left" />
        <ui:Button name="quit-button" text="Quitter" class="ui-button ui-corner--bottom-right" />
    </ui:VisualElement>
</ui:UXML>
