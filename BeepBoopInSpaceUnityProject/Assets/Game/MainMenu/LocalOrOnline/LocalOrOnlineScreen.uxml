<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../UI/MainMenu.uss" />
    <ui:VisualElement name="local-or-online-screen" class="ui-screen" picking-mode="Ignore">
        <ui:VisualElement class="ui-background" picking-mode="Ignore" />
        <ui:VisualElement class="ui-title" picking-mode="Ignore">
            <ui:VisualElement class="ui-title__fill" picking-mode="Ignore" />
            <ui:VisualElement class="ui-title__border" picking-mode="Ignore" />
            <ui:Label text="JOUER" class="ui-title__label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="local-or-online__choices" picking-mode="Ignore">
            <ui:Button name="local-button" class="ui-tile local-or-online__choice">
                <ui:VisualElement class="ui-filigree" picking-mode="Ignore" />
                <ui:Label text="En local" class="ui-text ui-tile__label" picking-mode="Ignore" />
                <ui:Label text="Sur cet écran, de 1 à 4 joueurs" class="ui-text local-or-online__note" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="online-button" class="ui-tile local-or-online__choice">
                <ui:VisualElement class="ui-filigree" picking-mode="Ignore" />
                <ui:Label text="En ligne" class="ui-text ui-tile__label" picking-mode="Ignore" />
                <ui:Label text="Une salle, un code" class="ui-text local-or-online__note" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
        <ui:Button name="back-button" focusable="false" class="ui-legend ui-legend--back">
            <ui:Label text="Retour" class="ui-text ui-legend__label" picking-mode="Ignore" />
            <ui:VisualElement name="back-glyph" class="ui-glyph ui-legend__glyph--after" picking-mode="Ignore" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
