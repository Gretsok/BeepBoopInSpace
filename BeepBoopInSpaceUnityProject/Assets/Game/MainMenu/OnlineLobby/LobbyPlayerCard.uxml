<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- A player of the online room, bound by OnlineLobbyScreen: robot, badge, robot's name, who it is. -->
    <ui:VisualElement name="card" class="ui-panel lobby__card" picking-mode="Ignore">
        <ui:VisualElement class="ui-filigree" picking-mode="Ignore" />
        <ui:VisualElement name="icon" class="lobby__card-icon" picking-mode="Ignore" />
        <ui:VisualElement name="badge" class="ui-badge lobby__card-badge" picking-mode="Ignore">
            <ui:Label name="badge-label" class="ui-badge__label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="name" class="ui-text lobby__card-name" picking-mode="Ignore" />
        <ui:Label name="tag" class="ui-text lobby__card-tag" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
