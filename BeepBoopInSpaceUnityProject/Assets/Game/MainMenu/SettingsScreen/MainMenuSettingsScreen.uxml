<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="VolumeRow" src="../../UITools/Screens/VolumeRow.uxml" />
    <Style src="../UI/MainMenu.uss" />
    <ui:VisualElement name="settings-screen" class="ui-screen" picking-mode="Ignore">
        <ui:VisualElement class="ui-background" picking-mode="Ignore" />
        <ui:VisualElement class="ui-title" picking-mode="Ignore">
            <ui:VisualElement class="ui-title__fill" picking-mode="Ignore" />
            <ui:VisualElement class="ui-title__border" picking-mode="Ignore" />
            <ui:Label text="PARAMÈTRES" class="ui-title__label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="settings__volumes" picking-mode="Ignore">
            <ui:Instance template="VolumeRow" name="master-volume">
                <ui:AttributeOverrides element-name="label" text="Volume général" />
            </ui:Instance>
            <ui:Instance template="VolumeRow" name="music-volume">
                <ui:AttributeOverrides element-name="label" text="Musique" />
            </ui:Instance>
            <ui:Instance template="VolumeRow" name="sfx-volume">
                <ui:AttributeOverrides element-name="label" text="Effets sonores" />
            </ui:Instance>
        </ui:VisualElement>
        <ui:Button name="back-button" focusable="false" class="ui-legend ui-legend--back">
            <ui:Label text="Retour" class="ui-text ui-legend__label" picking-mode="Ignore" />
            <ui:VisualElement name="back-glyph" class="ui-glyph ui-legend__glyph--after" picking-mode="Ignore" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
