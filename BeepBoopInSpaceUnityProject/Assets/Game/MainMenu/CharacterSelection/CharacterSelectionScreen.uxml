<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="PlayerSlot" src="PlayerSlot.uxml" />
    <Style src="../UI/MainMenu.uss" />
    <ui:VisualElement name="character-selection-screen" class="mm-screen cs-screen" picking-mode="Ignore">
        <ui:VisualElement class="mm-background" picking-mode="Ignore" />
        <ui:VisualElement class="mm-title" picking-mode="Ignore">
            <ui:VisualElement class="mm-title__fill" picking-mode="Ignore" />
            <ui:VisualElement class="mm-title__border" picking-mode="Ignore" />
            <ui:Label text="CHARACTER SELECTION" class="mm-title__label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="cs-insert cs-insert--left" picking-mode="Ignore">
            <ui:VisualElement class="cs-insert__fill" picking-mode="Ignore" />
            <ui:VisualElement class="cs-insert__border" picking-mode="Ignore" />
            <ui:VisualElement name="random-glyph" class="mm-glyph cs-insert__glyph cs-insert__glyph--first" picking-mode="Ignore" />
            <ui:Label text="Aléatoire" class="mm-text cs-insert__label cs-insert__label--random" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="cs-insert cs-insert--right" picking-mode="Ignore">
            <ui:VisualElement class="cs-insert__fill" picking-mode="Ignore" />
            <ui:VisualElement class="cs-insert__border" picking-mode="Ignore" />
            <ui:VisualElement name="call-left-glyph" class="mm-glyph cs-insert__glyph cs-insert__glyph--first" picking-mode="Ignore" />
            <ui:Label text="Appeler" class="mm-text cs-insert__label cs-insert__label--call" picking-mode="Ignore" />
            <ui:VisualElement name="call-right-glyph" class="mm-glyph cs-insert__glyph cs-insert__glyph--last" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="player-slots" class="cs-slots" picking-mode="Ignore">
            <ui:Instance template="PlayerSlot" name="player-slot-1" class="cs-slots__slot cs-slot--p1" picking-mode="Ignore" />
            <ui:Instance template="PlayerSlot" name="player-slot-2" class="cs-slots__slot cs-slot--p2" picking-mode="Ignore" />
            <ui:Instance template="PlayerSlot" name="player-slot-3" class="cs-slots__slot cs-slot--p3" picking-mode="Ignore" />
            <ui:Instance template="PlayerSlot" name="player-slot-4" class="cs-slots__slot cs-slot--p4" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="roster" class="cs-roster" picking-mode="Ignore" />
        <ui:Button name="back-button" focusable="false" class="mm-legend mm-legend--back">
            <ui:Label text="Retour" class="mm-text mm-legend__label" picking-mode="Ignore" />
            <ui:VisualElement name="back-glyph" class="mm-glyph mm-legend__glyph--after" picking-mode="Ignore" />
        </ui:Button>
        <ui:VisualElement name="ready-legend" class="mm-legend mm-legend--action" picking-mode="Ignore">
            <ui:VisualElement name="ready-glyph" class="mm-glyph" picking-mode="Ignore" />
            <ui:Label text="Prêts ?" class="mm-text mm-legend__label cs-legend__label--ready" picking-mode="Ignore" />
            <ui:Label text="C'est parti !" class="mm-text mm-legend__label cs-legend__label--launch" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
