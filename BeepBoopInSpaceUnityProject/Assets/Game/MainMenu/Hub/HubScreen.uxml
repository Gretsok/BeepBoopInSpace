<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="ConfirmationDialog" src="../../UITools/Screens/ConfirmationDialog.uxml" />
    <Style src="../UI/MainMenu.uss" />
    <ui:VisualElement name="hub-screen" class="ui-screen" picking-mode="Ignore">
        <ui:VisualElement class="ui-background" picking-mode="Ignore" />
        <ui:VisualElement class="ui-title" picking-mode="Ignore">
            <ui:VisualElement class="ui-title__fill" picking-mode="Ignore" />
            <ui:VisualElement class="ui-title__border" picking-mode="Ignore" />
            <ui:Label text="MODE DE JEU" class="ui-title__label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Button name="settings-button" text="Paramètres" class="ui-button ui-corner--top-left" />
        <ui:Button name="quit-button" text="Quitter" class="ui-button ui-corner--top-right" />
        <ui:VisualElement class="hub-modes" picking-mode="Ignore">
            <ui:Button name="tournament-button" class="ui-tile hub-mode">
                <ui:VisualElement class="ui-filigree" picking-mode="Ignore" />
                <ui:Label text="Tournoi" class="ui-text ui-tile__label" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="training-button" class="ui-tile hub-mode">
                <ui:VisualElement class="ui-filigree" picking-mode="Ignore" />
                <ui:Label text="Entraînement" class="ui-text ui-tile__label" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="online-button" class="ui-tile hub-mode">
                <ui:VisualElement class="ui-filigree" picking-mode="Ignore" />
                <ui:Label text="En ligne" class="ui-text ui-tile__label" picking-mode="Ignore" />
                <ui:Label text="Une salle, un code" class="ui-text hub-mode__note" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement class="ui-centered-row hub-character-selection-row" picking-mode="Ignore">
            <ui:Button name="character-selection-button" text="Sélection des personnages" class="ui-button" />
        </ui:VisualElement>
        <ui:VisualElement class="ui-centered-row hub-bots-row" picking-mode="Ignore">
            <ui:Button name="bots-button" class="ui-button" />
        </ui:VisualElement>
        <ui:Instance template="ConfirmationDialog" name="tournament-confirmation" class="ui-dialog">
            <ui:AttributeOverrides element-name="title" text="Tournoi" />
            <ui:AttributeOverrides element-name="message" text="Les parties s'enchaînent jusqu'au sacre d'un champion.&#10;On lance le tournoi ?" />
        </ui:Instance>
        <ui:Instance template="ConfirmationDialog" name="notice" class="ui-dialog">
            <ui:AttributeOverrides element-name="title" text="Partie en ligne terminée" />
        </ui:Instance>
    </ui:VisualElement>
</ui:UXML>
