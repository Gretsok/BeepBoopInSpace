<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../UI/MainMenu.uss" />
    <ui:VisualElement name="hub-screen" class="mm-screen" picking-mode="Ignore">
        <ui:Button name="settings-button" text="Paramètres" class="mm-button mm-button--primary hub-settings" />
        <ui:VisualElement class="mm-centered-row hub-tournament-row" picking-mode="Ignore">
            <ui:Button name="tournament-button" text="Tournoi" class="mm-button mm-button--primary" />
        </ui:VisualElement>
        <ui:Button name="character-selection-button" text="Sélection des personnages" class="mm-button mm-button--primary hub-side-button hub-character-selection" />
        <ui:Button name="training-button" text="Entraînement" class="mm-button mm-button--primary hub-side-button hub-training" />
        <ui:VisualElement class="mm-centered-row hub-quit-row" picking-mode="Ignore">
            <ui:Button name="quit-button" text="Quitter" class="mm-button mm-button--primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
