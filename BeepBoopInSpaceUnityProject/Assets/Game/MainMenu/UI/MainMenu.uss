/*
 * Main menu styles, shared by every screen. Sizes are in the 1920x1080 reference resolution of
 * MainMenuPanelSettings, which scales the UI to the screen width.
 * Colors, fonts and components come from the character selection mockup (RawAssets/UI/Menus/UI_CharacterSelection.psd),
 * the only one of the menu: see the ui-toolkit-screens skill's style guide for what it defines and what it doesn't.
 * Focus is the selection state for every device: gamepad and keyboard move it, the mouse focuses what it hovers.
 */

.mm-screen {
    --mm-ink: rgb(3, 27, 38);
    --mm-outline: rgb(189, 219, 226);
    --mm-text: rgb(188, 223, 237);
    --mm-navy: rgb(22, 79, 108);
    --mm-navy-faded: rgba(22, 79, 108, 0.2);
    --mm-locked: rgb(189, 189, 189);
    --mm-filigree: rgb(25, 90, 124);

    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--mm-text);
}

.mm-screen,
.mm-screen .unity-text-element {
    -unity-font-definition: url("/Assets/RawAssets/UI/Fonts/Boogaloo-Regular.ttf");
}

/* The mockup's background: a gradient, light down to y 750 then dark, with a pattern of creatures. */
.mm-background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/RawAssets/UI/Menus/Communs/SPR_Background.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* Light texts with the mockup's bevel, a dark line under the letters. Light on dark only: on dark shapes or low on the background. */
.mm-screen .mm-text {
    margin: 0;
    padding: 0;
    font-size: 40px;
    color: var(--mm-text);
    text-shadow: 0 2px 1px rgba(0, 0, 0, 0.45);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* An input sprite: its button is 3/4 of the sprite, tinted like the mockup's buttons. */
.mm-glyph {
    width: 57px;
    height: 57px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--mm-outline);
}

/*
 * The background's pattern seen through the dark shapes: a full screen texture that AMainMenuScreen moves to line up
 * with the background, clipped by its parent (border-radius and overflow: hidden).
 */
.mm-filigree {
    position: absolute;
    left: 0;
    top: 0;
    width: 1920px;
    height: 1080px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_Filigree.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--mm-filigree);
}

/* The title cartouche, hanging from the top of the screen. */

.mm-title {
    position: absolute;
    left: 495px;
    top: 0;
    width: 935px;
    height: 121px;
}

.mm-title__fill,
.mm-title__border {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.mm-title__fill {
    background-image: url("/Assets/RawAssets/UI/Menus/Communs/SPR_UpperBorderInt.png");
    -unity-background-image-tint-color: var(--mm-ink);
}

.mm-title__border {
    background-image: url("/Assets/RawAssets/UI/Menus/Communs/SPR_UpperBorderExt.png");
    -unity-background-image-tint-color: var(--mm-outline);
}

/* BeepBoop Bold isn't in the project: bold and spacing on the regular font. */
.mm-screen .mm-title__label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 95px;
    margin: 0;
    padding: 0;
    -unity-font-definition: url("/Assets/RawAssets/UI/Fonts/BeepBoop.otf");
    -unity-font-style: bold;
    font-size: 46px;
    letter-spacing: 5px;
    color: var(--mm-text);
    text-shadow: 0 2px 1px rgba(0, 0, 0, 0.45);
    -unity-text-align: middle-center;
}

/* Legends of the bottom corners: Retour (label then button), and the main action (button then label). */

.mm-legend {
    position: absolute;
    height: 57px;
    flex-direction: row;
    align-items: center;
}

/* Retour is also a button, for the mouse; B, Circle and Escape reach the screen's HandleCancel. */
.mm-legend--back {
    left: 82px;
    top: 991.5px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    transition-property: scale;
    transition-duration: 0.1s;
}

.mm-legend--back:hover {
    scale: 1.08 1.08;
}

/* Next to a button, Boogaloo's ink sits higher than the middle of its line. */
.mm-screen .mm-legend__label {
    translate: 0 -5px;
}

.mm-legend__glyph--after {
    margin-left: 12px;
}

.mm-legend--action {
    right: 63px;
    top: 990px;
}

.mm-screen .mm-legend--action .mm-legend__label {
    margin-left: 19px;
}

/*
 * Buttons: the mockup's inserts (ink, light outline, rounded), which it never shows selected. Selected follows its
 * language of states, white for what is being chosen: white outline, lighter fill, white text, and a pop.
 * The code removes Unity's button class from them, so these rules are their whole style.
 */

.mm-button {
    height: 68px;
    margin: 0;
    padding: 9px 40px 0 40px;
    border-width: 3px;
    border-radius: 24px;
    border-color: var(--mm-outline);
    background-color: var(--mm-ink);
    color: var(--mm-text);
    font-size: 35px;
    text-shadow: 0 2px 1px rgba(0, 0, 0, 0.45);
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: scale, border-width, border-color, background-color, color;
    transition-duration: 0.1s, 0.1s, 0.1s, 0.1s, 0.1s;
    transition-timing-function: ease-out-sine, ease-out-sine, ease-out-sine, ease-out-sine, ease-out-sine;
}

.mm-button:focus {
    scale: 1.1 1.1;
    border-width: 5px;
    border-color: rgb(255, 255, 255);
    background-color: var(--mm-navy);
    color: rgb(255, 255, 255);
    transition-duration: 0.3s, 0.1s, 0.1s, 0.1s, 0.1s;
    transition-timing-function: ease-out-back, ease-out-sine, ease-out-sine, ease-out-sine, ease-out-sine;
}

.mm-button:active {
    background-color: var(--mm-ink);
}

.mm-button:disabled {
    opacity: 0.5;
}

/* The screen's main action. */
.mm-button--big {
    height: 150px;
    padding: 20px 110px 0 110px;
    border-width: 4px;
    border-radius: 52px;
    font-size: 88px;
}

.mm-button--big:focus {
    border-width: 7px;
}

/*
 * Tiles: the mockup's dark shapes (the players' circles), navy with the background's pattern. Selected, like a grid
 * cell aimed at: a white ring. The text is a child label, drawn above the pattern.
 */

.mm-tile {
    margin: 0;
    padding: 0;
    border-width: 6px;
    border-radius: 48px;
    border-color: var(--mm-navy);
    background-color: var(--mm-navy);
    overflow: hidden;
    justify-content: center;
    align-items: center;
    transition-property: scale, border-color;
    transition-duration: 0.1s, 0.1s;
    transition-timing-function: ease-out-sine, ease-out-sine;
}

.mm-tile:focus {
    scale: 1.1 1.1;
    border-color: rgb(255, 255, 255);
    transition-duration: 0.3s, 0.1s;
    transition-timing-function: ease-out-back, ease-out-sine;
}

.mm-tile:disabled {
    opacity: 0.5;
}

.mm-screen .mm-tile__label {
    font-size: 72px;
    -unity-text-align: middle-center;
    translate: 0 -8px;
}

.mm-tile:focus .mm-tile__label {
    color: rgb(255, 255, 255);
}

/* Rows that center a button horizontally, and corner placements: the mockup's inserts on top, its legends at the bottom. */

.mm-centered-row {
    position: absolute;
    left: 0;
    right: 0;
    align-items: center;
}

.mm-corner--top-left {
    position: absolute;
    left: 26.5px;
    top: 22px;
}

.mm-corner--top-right {
    position: absolute;
    right: 26.5px;
    top: 22px;
}

.mm-corner--bottom-left {
    position: absolute;
    left: 60px;
    bottom: 26px;
}

.mm-corner--bottom-right {
    position: absolute;
    right: 60px;
    bottom: 26px;
}

/* Home: over the 3D scene of the main menu, with the game's title in its own font. */

.home-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 90px;
    align-items: center;
}

.mm-screen .home-title__line {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("/Assets/RawAssets/UI/Fonts/BeepBoop.otf");
    -unity-font-style: bold;
    color: var(--mm-text);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--mm-ink);
    text-shadow: 0 6px 2px rgba(3, 27, 38, 0.6);
    -unity-text-align: middle-center;
}

.mm-screen .home-title__main {
    font-size: 130px;
    letter-spacing: 10px;
}

.mm-screen .home-title__sub {
    margin-top: 6px;
    font-size: 70px;
    letter-spacing: 7px;
}

.home-play-row {
    top: 440px;
}

.home-credits-row {
    top: 680px;
}

/* Hub */

.hub-modes {
    position: absolute;
    left: 0;
    right: 0;
    top: 270px;
    flex-direction: row;
    justify-content: center;
}

.hub-mode {
    width: 600px;
    height: 330px;
    margin: 0 45px;
}

.hub-character-selection-row {
    top: 730px;
}

/* Credits */

.credits__panel {
    position: absolute;
    left: 250px;
    right: 250px;
    top: 165px;
    bottom: 120px;
    border-radius: 48px;
    background-color: var(--mm-navy);
    overflow: hidden;
}

.credits__column {
    position: absolute;
    top: 70px;
    width: 50%;
    align-items: center;
}

.credits__column--left {
    left: 0;
}

.credits__column--right {
    right: 0;
}

.credits__extra {
    position: absolute;
    left: 0;
    right: 0;
    top: 490px;
    align-items: center;
}

.mm-screen .credits__section {
    height: 70px;
    margin-bottom: 10px;
    -unity-font-definition: url("/Assets/RawAssets/UI/Fonts/BeepBoop.otf");
    -unity-font-style: bold;
    font-size: 42px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.mm-screen .credits__section--spaced {
    margin-top: 50px;
}

.mm-screen .credits__name {
    height: 54px;
    -unity-text-align: middle-center;
}

.credits__logo {
    position: absolute;
    right: 40px;
    bottom: 20px;
    width: 200px;
    height: 200px;
    background-image: url("/Assets/RawAssets/UI/LogoVBleu.png");
    -unity-background-scale-mode: scale-to-fit;
}

.mm-screen .credits__font {
    position: absolute;
    right: 63px;
    top: 991.5px;
    height: 57px;
    font-size: 32px;
    translate: 0 -5px;
}

/*
 * Character selection. Positions and colors come from the mockup, whose sprites are drawn at half their size and
 * tinted. Each circle is a PlayerSlot: join, selecting or ready.
 */

.cs-insert {
    position: absolute;
    top: 22px;
    width: 280px;
    height: 68.5px;
}

.cs-insert--left {
    left: 26.5px;
}

.cs-insert--right {
    right: 26.5px;
}

.cs-insert__fill,
.cs-insert__border {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.cs-insert__fill {
    background-image: url("/Assets/RawAssets/UI/Menus/Communs/SPR_ButtonInterior.png");
    -unity-background-image-tint-color: var(--mm-ink);
}

.cs-insert__border {
    background-image: url("/Assets/RawAssets/UI/Menus/Communs/SPR_ButtonExterior.png");
    -unity-background-image-tint-color: var(--mm-outline);
}

.cs-insert__glyph {
    position: absolute;
    top: 8px;
}

.cs-insert--left .cs-insert__glyph--first {
    left: 26.5px;
}

.cs-insert--right .cs-insert__glyph--first {
    left: 22.5px;
}

.cs-insert__glyph--last {
    left: 195.5px;
}

.mm-screen .cs-insert__label {
    position: absolute;
    top: 0;
    bottom: 0;
    font-size: 35px;
}

.cs-insert__label--random {
    left: 108px;
}

.cs-insert__label--call {
    left: 90px;
}

.cs-legend__label--launch,
.cs-screen--launching .cs-legend__label--ready,
.cs-screen--launching .mm-legend--action .mm-glyph {
    display: none;
}

.cs-screen--launching .cs-legend__label--launch {
    display: flex;
}

/* The players' circles, centered in a row: the players, then the circle of the next player to join. */

/* A little right of the center, like the mockup. */
.cs-slots {
    position: absolute;
    left: 8px;
    right: -8px;
    top: 206px;
    height: 440px;
    flex-direction: row;
    justify-content: center;
}

.cs-slots__slot {
    width: 440px;
    height: 440px;
    margin: 0 19px;
    flex-shrink: 0;
}

.cs-slot {
    position: absolute;
    left: 0;
    top: 0;
    width: 440px;
    height: 440px;
}

.cs-slot__circle {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 438px;
    height: 438px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_CircleBackground.png");
    -unity-background-image-tint-color: var(--mm-navy);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.3s;
}

.cs-slot--ready .cs-slot__circle {
    -unity-background-image-tint-color: var(--mm-navy-faded);
}

.cs-slot__circle-pattern {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 438px;
    height: 438px;
    border-radius: 219px;
    overflow: hidden;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.cs-slot--ready .cs-slot__circle-pattern {
    opacity: 0;
}

/* Selecting: a dashed ring. Ready: the ring is stamped away by a scalloped disc in the character's color. */

.cs-slot__ring {
    position: absolute;
    left: 27px;
    top: 27px;
    width: 385px;
    height: 385px;
    transition-property: opacity, scale, rotate;
    transition-duration: 0.3s, 0.3s, 0.3s;
    transition-timing-function: ease-out-sine, ease-out-back, ease-out-sine;
}

.cs-slot--p1 .cs-slot__ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderIntPlayer1NoReady.psd.png");
}

.cs-slot--p2 .cs-slot__ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderIntPlayer2NoReady.psd.png");
}

.cs-slot--p3 .cs-slot__ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderIntPlayer3NoReady.psd.png");
}

.cs-slot--p4 .cs-slot__ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderIntPlayer4NoReady.psd.png");
}

.cs-slot--ready .cs-slot__ring {
    opacity: 0;
    scale: 0.8 0.8;
    rotate: 90deg;
    transition-duration: 0.25s, 0.25s, 0.25s;
    transition-timing-function: ease-in-sine, ease-in-sine, ease-in-sine;
}

.cs-slot__ready-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 440px;
    height: 440px;
    opacity: 0;
    scale: 1.35 1.35;
    rotate: -45deg;
    transition-property: opacity, scale, rotate;
    transition-duration: 0.15s, 0.15s, 0.15s;
    transition-timing-function: ease-in-sine, ease-in-sine, ease-in-sine;
}

.cs-slot--ready .cs-slot__ready-layer {
    opacity: 1;
    scale: 1 1;
    rotate: 0deg;
    transition-duration: 0.15s, 0.5s, 0.5s;
    transition-timing-function: ease-out-sine, ease-out-back, ease-out-back;
}

.cs-slot__scallop {
    position: absolute;
    left: 31.5px;
    top: 32.5px;
    width: 375px;
    height: 375px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_CircleBackgroundPlayerReady.png");
    -unity-background-image-tint-color: var(--mm-navy);
}

.cs-slot__scallop-pattern {
    position: absolute;
    left: 41px;
    top: 42px;
    width: 356px;
    height: 356px;
    border-radius: 178px;
    overflow: hidden;
}

.cs-slot__scallop-line {
    position: absolute;
    left: 29px;
    top: 30px;
    width: 380px;
    height: 380px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderExtPlayerReady.png");
}

.cs-slot__ready-ring {
    position: absolute;
    left: 54px;
    top: 54.5px;
    width: 330px;
    height: 330px;
}

.cs-slot--p1 .cs-slot__ready-ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderIntPlayer1Ready.psd.png");
}

.cs-slot--p2 .cs-slot__ready-ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BordureIntJoueur2Ready.psd.png");
}

.cs-slot--p3 .cs-slot__ready-ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderIntPlayer3Ready.psd.png");
}

.cs-slot--p4 .cs-slot__ready-ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BordureIntJoueur4Ready.psd.png");
}

/* The shockwave and confetti of getting ready start from the center of the circle. */
.cs-slot__burst {
    position: absolute;
    left: 220px;
    top: 220px;
    width: 0;
    height: 0;
}

.cs-slot__shockwave {
    position: absolute;
    left: -190px;
    top: -190px;
    width: 380px;
    height: 380px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderExtPlayerReady.png");
}

.cs-slot__flash {
    position: absolute;
    left: -187.5px;
    top: -187.5px;
    width: 375px;
    height: 375px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_CircleBackgroundPlayerReady.png");
}

.cs-slot__particle {
    position: absolute;
    left: 0;
    top: 0;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_IconeNumberPlayerReady.png");
}

/* The character's picture, set by CharacterWidget (a grey robot stands in for a missing one). */
.cs-slot__preview {
    position: absolute;
    left: 70px;
    top: 85px;
    width: 300px;
    height: 300px;
    background-position-x: center;
    background-position-y: bottom;
    background-size: contain;
    background-repeat: no-repeat;
    transform-origin: center bottom;
}

.cs-slot--join .cs-slot__preview {
    display: none;
}

.cs-slot__join {
    position: absolute;
    left: 108px;
    top: 200px;
    height: 57px;
    flex-direction: row;
    align-items: center;
    display: none;
}

.cs-slot--join .cs-slot__join {
    display: flex;
}

.mm-screen .cs-slot__join-label {
    margin-left: 18px;
    translate: 0 -5px;
}

/* The player's number ("+" in the circle to join), white until ready. */
.cs-slot__badge {
    position: absolute;
    left: -12.5px;
    top: 111px;
    width: 62.5px;
    height: 62.5px;
    justify-content: center;
    align-items: center;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_IconeNumberPlayerNoReady.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    transition-property: left, top, width, height, -unity-background-image-tint-color;
    transition-duration: 0.35s, 0.35s, 0.35s, 0.35s, 0.2s;
    transition-timing-function: ease-out-back, ease-out-back, ease-out-back, ease-out-back, ease-out-sine;
}

.cs-slot--ready .cs-slot__badge {
    left: 21.5px;
    top: 127px;
    width: 54px;
    height: 54px;
}

.mm-screen .cs-slot__badge-label {
    margin: 0;
    padding: 0;
    font-size: 38px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    transition-property: font-size, color;
    transition-duration: 0.3s, 0.2s;
}

.mm-screen .cs-slot--ready .cs-slot__badge-label {
    font-size: 32px;
    color: rgb(255, 255, 255);
}

/* The character grid: a badge per player on the character they point at, white until ready. */

.cs-roster {
    position: absolute;
    left: 347.5px;
    top: 735px;
    width: 1240px;
    flex-direction: row;
    flex-wrap: wrap;
}

.cs-cell {
    width: 104px;
    height: 104px;
    margin: 0 9.65px 47px 9.65px;
}

.cs-cell__background {
    position: absolute;
    left: -5.5px;
    top: -5px;
    width: 115px;
    height: 115px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BotSelectionCircleBackground.png");
    -unity-background-image-tint-color: var(--mm-locked);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.25s;
}

.cs-cell__contour {
    position: absolute;
    left: -5.5px;
    top: -5.5px;
    width: 115px;
    height: 115px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BotSelectionContourPlayerSelected.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    opacity: 0;
    transition-property: opacity, -unity-background-image-tint-color;
    transition-duration: 0.15s, 0.25s;
}

.cs-cell--hovered .cs-cell__contour,
.cs-cell--taken .cs-cell__contour {
    opacity: 1;
}

.cs-cell__icon {
    position: absolute;
    left: 2px;
    top: -40px;
    width: 100px;
    height: 125px;
    -unity-background-scale-mode: scale-to-fit;
}

.cs-cell__badges {
    position: absolute;
    left: 0;
    top: 68.5px;
    width: 98.5px;
    height: 37.5px;
    flex-direction: row-reverse;
}

.cs-cell__badge {
    width: 37.5px;
    height: 37.5px;
    margin-left: -6px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BotSelectionPlayerNumber.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.2s;
}

.mm-screen .cs-cell__badge-label {
    margin: 0;
    padding: 0;
    font-size: 23px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
}

.mm-screen .cs-cell__badge--ready .cs-cell__badge-label {
    color: rgb(255, 255, 255);
}

/* Level selection: the cards are tiles, between the title and the legends. */

.level-selection__levels {
    position: absolute;
    left: 0;
    right: 0;
    top: 130px;
    bottom: 100px;
}

.mm-screen .level-selection__levels .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding: 20px 40px;
}

.mm-screen .level-selection__levels .unity-scroller--vertical {
    width: 16px;
    margin: 30px 40px 30px 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mm-screen .level-selection__levels .unity-scroller__low-button,
.mm-screen .level-selection__levels .unity-scroller__high-button {
    display: none;
}

.mm-screen .level-selection__levels .unity-scroller--vertical .unity-scroller__slider {
    flex-grow: 1;
    width: 16px;
    margin: 0;
}

.mm-screen .level-selection__levels .unity-scroller--vertical .unity-base-slider__tracker {
    left: 0;
    right: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(3, 27, 38, 0.6);
}

.mm-screen .level-selection__levels .unity-scroller--vertical .unity-base-slider__dragger {
    left: 0;
    width: 16px;
    border-width: 0;
    border-radius: 8px;
    background-color: var(--mm-outline);
}

.level-card {
    width: 500px;
    height: 330px;
    margin: 30px 40px;
    padding: 0;
    border-width: 6px;
    border-radius: 30px;
    border-color: var(--mm-navy);
    background-color: var(--mm-navy);
    overflow: hidden;
    transition-property: scale, border-color;
    transition-duration: 0.1s, 0.1s;
    transition-timing-function: ease-out-sine, ease-out-sine;
}

.level-card:focus {
    scale: 1.1 1.1;
    border-color: rgb(255, 255, 255);
    transition-duration: 0.3s, 0.1s;
    transition-timing-function: ease-out-back, ease-out-sine;
}

.level-card__thumbnail {
    height: 210px;
    background-color: var(--mm-ink);
    -unity-background-scale-mode: scale-and-crop;
}

.mm-screen .level-card__name {
    flex-grow: 1;
    padding: 0 16px 8px 16px;
    font-size: 38px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.mm-screen .level-card:focus .level-card__name {
    color: rgb(255, 255, 255);
}

/* Settings: a tile per volume, selected with its slider. */

.settings__volumes {
    position: absolute;
    left: 310px;
    right: 310px;
    top: 230px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    height: 130px;
    margin-bottom: 50px;
    padding: 0 40px;
    border-width: 6px;
    border-radius: 48px;
    border-color: var(--mm-navy);
    background-color: var(--mm-navy);
    overflow: hidden;
    transition-property: scale, border-color;
    transition-duration: 0.1s, 0.1s;
    transition-timing-function: ease-out-sine, ease-out-sine;
}

.settings-row--focused {
    scale: 1.05 1.05;
    border-color: rgb(255, 255, 255);
    transition-duration: 0.3s, 0.1s;
    transition-timing-function: ease-out-back, ease-out-sine;
}

.mm-screen .settings-row__label {
    width: 380px;
    font-size: 48px;
    translate: 0 -5px;
}

.mm-screen .settings-row__value {
    width: 100px;
    font-size: 48px;
    -unity-text-align: middle-right;
    translate: 0 -5px;
}

.mm-screen .settings-row--focused .settings-row__label,
.mm-screen .settings-row--focused .settings-row__value {
    color: rgb(255, 255, 255);
}

.mm-screen .settings-row .settings-row__slider {
    flex-grow: 1;
    margin: 0 40px;
}

.mm-screen .settings-row .settings-row__slider .unity-base-slider__drag-container {
    height: 50px;
}

.mm-screen .settings-row .settings-row__slider .unity-base-slider__tracker {
    height: 18px;
    margin-top: -9px;
    border-width: 0;
    border-radius: 9px;
    background-color: var(--mm-ink);
}

.mm-screen .settings-row .settings-row__slider .unity-base-slider__fill {
    border-radius: 9px;
    background-color: var(--mm-outline);
}

.mm-screen .settings-row .settings-row__slider .unity-base-slider__dragger {
    width: 40px;
    height: 40px;
    margin-top: -20px;
    border-width: 4px;
    border-radius: 20px;
    border-color: var(--mm-ink);
    background-color: var(--mm-text);
    transition-property: scale, background-color;
    transition-duration: 0.1s, 0.1s;
}

.mm-screen .settings-row--focused .settings-row__slider .unity-base-slider__dragger {
    scale: 1.2 1.2;
    background-color: rgb(255, 255, 255);
}

.mm-screen .settings-row .settings-row__slider .unity-base-slider__dragger-border {
    display: none;
}
