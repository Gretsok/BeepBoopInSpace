/*
 * Main menu styles: a section per screen. The components of the style guide, shared with the other screens, are in
 * UITools/Screens/Common.uss, imported first.
 */

@import url("/Assets/Game/UITools/Screens/Common.uss");

/* Home: over the 3D scene of the main menu, with the game's title in its own font. */

.home-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 90px;
    align-items: center;
}

.ui-screen .home-title__line {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("/Assets/RawAssets/UI/Fonts/BeepBoop.otf");
    -unity-font-style: bold;
    color: var(--ui-text);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--ui-ink);
    text-shadow: 0 6px 2px rgba(3, 27, 38, 0.6);
    -unity-text-align: middle-center;
}

.ui-screen .home-title__main {
    font-size: 130px;
    letter-spacing: 10px;
}

.ui-screen .home-title__sub {
    margin-top: 6px;
    font-size: 70px;
    letter-spacing: 7px;
}

.home-play-row {
    top: 440px;
}

.home-credits-row {
    top: 680px;
}

.home-version {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 40px;
    -unity-text-align: middle-center;
    font-size: 30px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(2, 26, 38);
}

/* Hub */

.hub-modes {
    position: absolute;
    left: 0;
    right: 0;
    top: 270px;
    flex-direction: row;
    justify-content: center;
}

/* Tournoi and Entraînement, for this machine's players, then En ligne. */
.hub-mode {
    width: 520px;
    height: 330px;
    margin: 0 35px;
}

/* Under a mode's name: what it takes (Tournoi and Entraînement, alone on this machine), what it is (En ligne). */
.ui-screen .hub-mode__note {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 34px;
    font-size: 34px;
    -unity-text-align: middle-center;
}

.ui-tile:focus .hub-mode__note {
    color: rgb(255, 255, 255);
}

.hub-character-selection-row {
    top: 680px;
}

.hub-bots-row {
    top: 800px;
}

/* Credits */

.credits__panel {
    position: absolute;
    left: 250px;
    right: 250px;
    top: 165px;
    bottom: 120px;
    border-radius: 48px;
    background-color: var(--ui-navy);
    overflow: hidden;
}

.credits__column {
    position: absolute;
    top: 70px;
    width: 50%;
    align-items: center;
}

.credits__column--left {
    left: 0;
}

.credits__column--right {
    right: 0;
}

.credits__extra {
    position: absolute;
    left: 0;
    right: 0;
    top: 490px;
    align-items: center;
}

.ui-screen .credits__section {
    height: 70px;
    margin-bottom: 10px;
    -unity-font-definition: url("/Assets/RawAssets/UI/Fonts/BeepBoop.otf");
    -unity-font-style: bold;
    font-size: 42px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.ui-screen .credits__section--spaced {
    margin-top: 50px;
}

.ui-screen .credits__name {
    height: 54px;
    -unity-text-align: middle-center;
}

.credits__logo {
    position: absolute;
    right: 40px;
    bottom: 20px;
    width: 200px;
    height: 200px;
    background-image: url("/Assets/RawAssets/UI/LogoVBleu.png");
    -unity-background-scale-mode: scale-to-fit;
}

.ui-screen .credits__font {
    position: absolute;
    right: 63px;
    top: 991.5px;
    height: 57px;
    font-size: 32px;
    translate: 0 -5px;
}

/*
 * Character selection. Positions and colors come from the mockup, whose sprites are drawn at half their size and
 * tinted. Each circle is a PlayerSlot: join, selecting or ready.
 */

.cs-insert {
    position: absolute;
    top: 22px;
    width: 280px;
    height: 68.5px;
}

.cs-insert--left {
    left: 26.5px;
}

.cs-insert--right {
    right: 26.5px;
}

.cs-insert__fill,
.cs-insert__border {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.cs-insert__fill {
    background-image: url("/Assets/RawAssets/UI/Menus/Communs/SPR_ButtonInterior.png");
    -unity-background-image-tint-color: var(--ui-ink);
}

.cs-insert__border {
    background-image: url("/Assets/RawAssets/UI/Menus/Communs/SPR_ButtonExterior.png");
    -unity-background-image-tint-color: var(--ui-outline);
}

.cs-insert__glyph {
    position: absolute;
    top: 8px;
}

.cs-insert--left .cs-insert__glyph--first {
    left: 26.5px;
}

.cs-insert--right .cs-insert__glyph--first {
    left: 22.5px;
}

.cs-insert__glyph--last {
    left: 195.5px;
}

.ui-screen .cs-insert__label {
    position: absolute;
    top: 0;
    bottom: 0;
    font-size: 35px;
}

.cs-insert__label--random {
    left: 108px;
}

.cs-insert__label--call {
    left: 90px;
}

.cs-legend__label--launch,
.cs-screen--launching .cs-legend__label--ready,
.cs-screen--launching .ui-legend--action .ui-glyph {
    display: none;
}

.cs-screen--launching .cs-legend__label--launch {
    display: flex;
}

/* The players' circles, centered in a row: the players, then the circle of the next player to join. */

/* A little right of the center, like the mockup. */
.cs-slots {
    position: absolute;
    left: 8px;
    right: -8px;
    top: 206px;
    height: 440px;
    flex-direction: row;
    justify-content: center;
}

.cs-slots__slot {
    width: 440px;
    height: 440px;
    margin: 0 19px;
    flex-shrink: 0;
}

.cs-slot {
    position: absolute;
    left: 0;
    top: 0;
    width: 440px;
    height: 440px;
}

.cs-slot__circle {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 438px;
    height: 438px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_CircleBackground.png");
    -unity-background-image-tint-color: var(--ui-navy);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.3s;
}

.cs-slot--ready .cs-slot__circle {
    -unity-background-image-tint-color: var(--ui-navy-faded);
}

.cs-slot__circle-pattern {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 438px;
    height: 438px;
    border-radius: 219px;
    overflow: hidden;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.cs-slot--ready .cs-slot__circle-pattern {
    opacity: 0;
}

/* Selecting: a dashed ring. Ready: the ring is stamped away by a scalloped disc in the character's color. */

.cs-slot__ring {
    position: absolute;
    left: 27px;
    top: 27px;
    width: 385px;
    height: 385px;
    transition-property: opacity, scale, rotate;
    transition-duration: 0.3s, 0.3s, 0.3s;
    transition-timing-function: ease-out-sine, ease-out-back, ease-out-sine;
}

.cs-slot--p1 .cs-slot__ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderIntPlayer1NoReady.psd.png");
}

.cs-slot--p2 .cs-slot__ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderIntPlayer2NoReady.psd.png");
}

.cs-slot--p3 .cs-slot__ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderIntPlayer3NoReady.psd.png");
}

.cs-slot--p4 .cs-slot__ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderIntPlayer4NoReady.psd.png");
}

.cs-slot--ready .cs-slot__ring {
    opacity: 0;
    scale: 0.8 0.8;
    rotate: 90deg;
    transition-duration: 0.25s, 0.25s, 0.25s;
    transition-timing-function: ease-in-sine, ease-in-sine, ease-in-sine;
}

.cs-slot__ready-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 440px;
    height: 440px;
    opacity: 0;
    scale: 1.35 1.35;
    rotate: -45deg;
    transition-property: opacity, scale, rotate;
    transition-duration: 0.15s, 0.15s, 0.15s;
    transition-timing-function: ease-in-sine, ease-in-sine, ease-in-sine;
}

.cs-slot--ready .cs-slot__ready-layer {
    opacity: 1;
    scale: 1 1;
    rotate: 0deg;
    transition-duration: 0.15s, 0.5s, 0.5s;
    transition-timing-function: ease-out-sine, ease-out-back, ease-out-back;
}

.cs-slot__scallop {
    position: absolute;
    left: 31.5px;
    top: 32.5px;
    width: 375px;
    height: 375px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_CircleBackgroundPlayerReady.png");
    -unity-background-image-tint-color: var(--ui-navy);
}

.cs-slot__scallop-pattern {
    position: absolute;
    left: 41px;
    top: 42px;
    width: 356px;
    height: 356px;
    border-radius: 178px;
    overflow: hidden;
}

.cs-slot__scallop-line {
    position: absolute;
    left: 29px;
    top: 30px;
    width: 380px;
    height: 380px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderExtPlayerReady.png");
}

.cs-slot__ready-ring {
    position: absolute;
    left: 54px;
    top: 54.5px;
    width: 330px;
    height: 330px;
}

.cs-slot--p1 .cs-slot__ready-ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderIntPlayer1Ready.psd.png");
}

.cs-slot--p2 .cs-slot__ready-ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BordureIntJoueur2Ready.psd.png");
}

.cs-slot--p3 .cs-slot__ready-ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderIntPlayer3Ready.psd.png");
}

.cs-slot--p4 .cs-slot__ready-ring {
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BordureIntJoueur4Ready.psd.png");
}

/* The shockwave and confetti of getting ready start from the center of the circle. */
.cs-slot__burst {
    position: absolute;
    left: 220px;
    top: 220px;
    width: 0;
    height: 0;
}

.cs-slot__shockwave {
    position: absolute;
    left: -190px;
    top: -190px;
    width: 380px;
    height: 380px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BorderExtPlayerReady.png");
}

.cs-slot__flash {
    position: absolute;
    left: -187.5px;
    top: -187.5px;
    width: 375px;
    height: 375px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_CircleBackgroundPlayerReady.png");
}

.cs-slot__particle {
    position: absolute;
    left: 0;
    top: 0;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_IconeNumberPlayerReady.png");
}

/* The character's picture, set by CharacterWidget (a grey robot stands in for a missing one). */
.cs-slot__preview {
    position: absolute;
    left: 70px;
    top: 85px;
    width: 300px;
    height: 300px;
    background-position-x: center;
    background-position-y: bottom;
    background-size: contain;
    background-repeat: no-repeat;
    transform-origin: center bottom;
}

.cs-slot--join .cs-slot__preview {
    display: none;
}

.cs-slot__join {
    position: absolute;
    left: 108px;
    top: 200px;
    height: 57px;
    flex-direction: row;
    align-items: center;
    display: none;
}

.cs-slot--join .cs-slot__join {
    display: flex;
}

.ui-screen .cs-slot__join-label {
    margin-left: 18px;
    translate: 0 -5px;
}

/* The player's number ("+" in the circle to join), white until ready. */
.cs-slot__badge {
    position: absolute;
    left: -12.5px;
    top: 111px;
    width: 62.5px;
    height: 62.5px;
    justify-content: center;
    align-items: center;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_IconeNumberPlayerNoReady.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    transition-property: left, top, width, height, -unity-background-image-tint-color;
    transition-duration: 0.35s, 0.35s, 0.35s, 0.35s, 0.2s;
    transition-timing-function: ease-out-back, ease-out-back, ease-out-back, ease-out-back, ease-out-sine;
}

.cs-slot--ready .cs-slot__badge {
    left: 21.5px;
    top: 127px;
    width: 54px;
    height: 54px;
}

.ui-screen .cs-slot__badge-label {
    margin: 0;
    padding: 0;
    font-size: 38px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    transition-property: font-size, color;
    transition-duration: 0.3s, 0.2s;
}

.ui-screen .cs-slot--ready .cs-slot__badge-label {
    font-size: 32px;
    color: rgb(255, 255, 255);
}

/* The character grid: a badge per player on the character they point at, white until ready. */

.cs-roster {
    position: absolute;
    left: 347.5px;
    top: 735px;
    width: 1240px;
    flex-direction: row;
    flex-wrap: wrap;
}

.cs-cell {
    width: 104px;
    height: 104px;
    margin: 0 9.65px 47px 9.65px;
}

.cs-cell__background {
    position: absolute;
    left: -5.5px;
    top: -5px;
    width: 115px;
    height: 115px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BotSelectionCircleBackground.png");
    -unity-background-image-tint-color: var(--ui-locked);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.25s;
}

.cs-cell__contour {
    position: absolute;
    left: -5.5px;
    top: -5.5px;
    width: 115px;
    height: 115px;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BotSelectionContourPlayerSelected.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    opacity: 0;
    transition-property: opacity, -unity-background-image-tint-color;
    transition-duration: 0.15s, 0.25s;
}

.cs-cell--hovered .cs-cell__contour,
.cs-cell--taken .cs-cell__contour {
    opacity: 1;
}

.cs-cell__icon {
    position: absolute;
    left: 2px;
    top: -40px;
    width: 100px;
    height: 125px;
    -unity-background-scale-mode: scale-to-fit;
}

.cs-cell__badges {
    position: absolute;
    left: 0;
    top: 68.5px;
    width: 98.5px;
    height: 37.5px;
    flex-direction: row-reverse;
}

.cs-cell__badge {
    width: 37.5px;
    height: 37.5px;
    margin-left: -6px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    background-image: url("/Assets/RawAssets/UI/Menus/CharacterSelection/SPR_BotSelectionPlayerNumber.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.2s;
}

.ui-screen .cs-cell__badge-label {
    margin: 0;
    padding: 0;
    font-size: 23px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
}

.ui-screen .cs-cell__badge--ready .cs-cell__badge-label {
    color: rgb(255, 255, 255);
}

/* Level selection: the cards are tiles, between the title and the legends. */

.level-selection__levels {
    position: absolute;
    left: 0;
    right: 0;
    top: 130px;
    bottom: 100px;
}

.ui-screen .level-selection__levels .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding: 20px 40px;
}

.ui-screen .level-selection__levels .unity-scroller--vertical {
    width: 16px;
    margin: 30px 40px 30px 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ui-screen .level-selection__levels .unity-scroller__low-button,
.ui-screen .level-selection__levels .unity-scroller__high-button {
    display: none;
}

.ui-screen .level-selection__levels .unity-scroller--vertical .unity-scroller__slider {
    flex-grow: 1;
    width: 16px;
    margin: 0;
}

.ui-screen .level-selection__levels .unity-scroller--vertical .unity-base-slider__tracker {
    left: 0;
    right: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(3, 27, 38, 0.6);
}

.ui-screen .level-selection__levels .unity-scroller--vertical .unity-base-slider__dragger {
    left: 0;
    width: 16px;
    border-width: 0;
    border-radius: 8px;
    background-color: var(--ui-outline);
}

.level-card {
    width: 500px;
    height: 330px;
    margin: 30px 40px;
    padding: 0;
    border-width: 6px;
    border-radius: 30px;
    border-color: var(--ui-navy);
    background-color: var(--ui-navy);
    overflow: hidden;
    transition-property: scale, border-color;
    transition-duration: 0.1s, 0.1s;
    transition-timing-function: ease-out-sine, ease-out-sine;
}

.level-card:focus {
    scale: 1.1 1.1;
    border-color: rgb(255, 255, 255);
    transition-duration: 0.3s, 0.1s;
    transition-timing-function: ease-out-back, ease-out-sine;
}

.level-card__thumbnail {
    height: 210px;
    background-color: var(--ui-ink);
    -unity-background-scale-mode: scale-and-crop;
}

.ui-screen .level-card__name {
    flex-grow: 1;
    padding: 0 16px 8px 16px;
    font-size: 38px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.ui-screen .level-card:focus .level-card__name {
    color: rgb(255, 255, 255);
}

/* Settings: a tile per volume, selected with its slider. */

.settings__options {
    position: absolute;
    left: 0;
    right: 0;
    top: 800px;
    flex-direction: row;
    justify-content: center;
}

.settings__option {
    margin-left: 16px;
    margin-right: 16px;
}

.settings__volumes {
    position: absolute;
    left: 310px;
    right: 310px;
    top: 230px;
}


/* Online: create a room (left), or join one with its code (right). */

.online__columns {
    position: absolute;
    left: 0;
    right: 0;
    top: 200px;
    flex-direction: row;
    justify-content: center;
}

.online__column {
    width: 720px;
    height: 560px;
    margin: 0 40px;
}

.ui-screen .online__note {
    margin-top: 16px;
    font-size: 36px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.ui-tile:focus .online__note {
    color: rgb(255, 255, 255);
}

.online__join {
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.ui-screen .online__heading {
    font-size: 64px;
    -unity-text-align: middle-center;
}

.online__code {
    flex-direction: row;
    justify-content: center;
    margin: 26px 0 40px 0;
}

/* A box of the code: up and down change its character. */
.online__code-slot {
    width: 92px;
    height: 116px;
    margin: 0 8px;
    padding: 0 0 6px 0;
    border-width: 4px;
    border-radius: 20px;
    border-color: var(--ui-outline);
    background-color: var(--ui-ink);
    color: var(--ui-text);
    font-size: 68px;
    -unity-text-align: middle-center;
    transition-property: scale, border-color, background-color, color;
    transition-duration: 0.1s, 0.1s, 0.1s, 0.1s;
}

.online__code-slot:focus {
    scale: 1.15 1.15;
    border-width: 6px;
    border-color: rgb(255, 255, 255);
    background-color: var(--ui-navy);
    color: rgb(255, 255, 255);
    transition-duration: 0.3s, 0.1s, 0.1s, 0.1s;
    transition-timing-function: ease-out-back, ease-out-sine, ease-out-sine, ease-out-sine;
}

.online__code-slot--empty {
    color: var(--ui-outline);
}

.online__join-button {
    min-width: 320px;
}

.online__status-row {
    top: 860px;
}

/* Low on the background, where it is dark: a light text, on two lines if need be. */
.ui-screen .online__status {
    max-width: 1500px;
    font-size: 40px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.ui-screen .online__status--error {
    color: rgb(255, 196, 120);
}

/* Online room: its code, its 4 players, then the host's modes. */

.lobby__code-row {
    top: 150px;
}

.lobby__code-panel {
    flex-direction: row;
    align-items: center;
    height: 130px;
    padding: 0 30px 0 50px;
    overflow: hidden;
}

.ui-screen .lobby__code-label {
    margin-right: 30px;
    font-size: 40px;
}

.ui-screen .lobby__code {
    margin-right: 40px;
    font-size: 88px;
    letter-spacing: 12px;
    color: rgb(255, 255, 255);
    translate: 0 -4px;
}

.lobby__players {
    position: absolute;
    left: 0;
    right: 0;
    top: 315px;
    flex-direction: row;
    justify-content: center;
}

.lobby__player {
    margin: 0 18px;
}

.lobby__card {
    width: 380px;
    height: 430px;
    align-items: center;
    overflow: hidden;
}

.lobby__card-icon {
    width: 300px;
    height: 270px;
    margin-top: 16px;
    -unity-background-scale-mode: scale-to-fit;
}

.lobby__card-badge {
    position: absolute;
    left: 22px;
    top: 22px;
}

.ui-screen .lobby__card-name {
    font-size: 48px;
    -unity-text-align: middle-center;
}

.ui-screen .lobby__card-tag {
    height: 46px;
    font-size: 34px;
    color: var(--ui-outline);
    -unity-text-align: middle-center;
}

/* This machine's players: a white ring. */
.lobby__player--local .lobby__card {
    border-color: rgb(255, 255, 255);
}

.ui-screen .lobby__player--local .lobby__card-tag {
    color: rgb(255, 255, 255);
}

/* A free place, waiting for a player. */
.lobby__player--empty .lobby__card {
    opacity: 0.45;
}

.lobby__player--empty .lobby__card-badge {
    display: none;
}

.lobby__modes {
    top: 785px;
}

.lobby__modes-row {
    flex-direction: row;
}

.lobby__mode {
    width: 440px;
    height: 130px;
    margin: 0 30px;
}

.ui-screen .lobby__mode-label {
    font-size: 60px;
}

.lobby__hint-row {
    top: 935px;
}

/* Between the legends, low on the background where it is dark. */
.ui-screen .lobby__hint {
    font-size: 36px;
    -unity-text-align: middle-center;
}
